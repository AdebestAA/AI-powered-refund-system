PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5179

# PostgreSQL, e.g. postgres://user:pass@localhost:5432/resolve
DB_URI=
DB_SSL=false
DB_POOL_MAX=10

# Required in production. Dev falls back to built-in values.
JWT_ACCESS_SECRET=
ENCRYPTION_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Brevo — without an API key, OTP codes are printed to the API console.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Resolve Support
